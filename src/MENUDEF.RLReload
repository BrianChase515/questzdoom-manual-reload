AddOptionMenu "OptionsMenu"
{
	Submenu "Manual Reload Settings", "RL_Settings"
}

OptionMenu "RL_Settings"
{
	Title "Manual Reload"
	StaticText " "
	StaticText "Reload button: anything bound to Reload", 1
	StaticText "(right stick click by default)", 1
	StaticText " "
	Option "Dropped mag loses its rounds", "rl_droppedmag_loses_rounds", "OnOff"
	StaticText "Off = leftover rounds go back to your reserve", 1
}
