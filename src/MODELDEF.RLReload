// Muzzle flash (copied from HDVR)
Model RL_Pistol
{
	Path "Models/Weapons/Hud/Pistol"
	Model 0 "Pistol-MF.MD3"
	Skin 0 "MF2.png"
	Scale 1.5 1.2 1.5
	Offset 0.0 -3.0 0.0
	FrameIndex PISF A 0 2
}

// Off hand: WebXR generic hand (MIT). Frame letter = pose + 4 * orientation
//   poses: 0 relaxed, 1 grip, 2 holding mag, 3 pinch;  orientations: 0 palm down, 1 / 2 palm sideways
Model RL_OffHand
{
	Path "Models/Weapons/Hud/Pistol"
	Model 0 "RL_Hand.md3"
	Skin 0 "RL_Glove.png"
	Scale -1.0 1.0 1.0
	NOINTERPOLATION

	FrameIndex RLHD A 0 0
	FrameIndex RLHD B 0 1
	FrameIndex RLHD D 0 3
	FrameIndex RLHD E 0 4
	FrameIndex RLHD F 0 5
	FrameIndex RLHD H 0 7
	FrameIndex RLHD I 0 8
	FrameIndex RLHD J 0 9
	FrameIndex RLHD L 0 11
}

// every model in a block is drawn on every frame of that block, so the magazine gets its own block
Model RL_OffHand
{
	Path "Models/Weapons/Hud/Pistol"
	Model 0 "RL_Hand.md3"
	Skin 0 "RL_Glove.png"
	Model 1 "RL_Mag.md3"
	Skin 1 "Pistol.png"
	Scale -1.0 1.0 1.0
	NOINTERPOLATION

	FrameIndex RLHD C 0 2
	FrameIndex RLHD C 1 1
	FrameIndex RLHD G 0 6
	FrameIndex RLHD G 1 2
	FrameIndex RLHD K 0 10
	FrameIndex RLHD K 1 3
}

// Dropped magazine: falling upright (frame 5), lying on the floor (frame 4); world scale ~0.4 of the hand model
Model RL_DroppedMag
{
	Path "Models/Weapons/Hud/Pistol"
	Model 0 "RL_Mag.md3"
	Skin 0 "Pistol.png"
	Scale 0.45 0.45 0.45
	FrameIndex RLMG A 0 5
	FrameIndex RLMG B 0 4
}

// Ejected live round
Model RL_EjectedRound
{
	Path "Models/Weapons/Hud/Pistol"
	Model 0 "RL_Round.md3"
	Skin 0 "Pistol.png"
	Scale 0.65 0.65 0.65
	FrameIndex RLRD A 0 0
}
