// Player class: same as the HDVR pack's marine, but with the reloadable pistol.
// (DoomMarineGuy comes from HDVRweapons_Plus / HDVRweapons_Quest_Plus, so load
// this mod AFTER the weapon pack.)
ACTOR RL_Marine : DoomMarineGuy
{
	Player.JumpZ 0          // B is the magazine release
	Player.StartItem "RL_Pistol"
	Player.StartItem "Vanilla_Fist"
	Player.StartItem "Clip", 50
	Player.WeaponSlot 1, Vanilla_Fist, Vanilla_Chainsaw
	Player.WeaponSlot 2, RL_Pistol
	Player.WeaponSlot 3, RL_Shotgun, Vanilla_SuperShotgun
	Player.WeaponSlot 4, Vanilla_Chaingun
	Player.WeaponSlot 5, Vanilla_RocketLauncher
	Player.WeaponSlot 6, Vanilla_PlasmaRifle
	Player.WeaponSlot 7, Vanilla_BFG9000
}

// Pistols placed in maps become the reloadable one.
ACTOR RL_PistolSpawner : RandomSpawner replaces Pistol
{
	DropItem "RL_Pistol"
}

// Shotguns placed in maps (and dropped by shotgun guys) become the pump-action one.
ACTOR RL_ShotgunSpawner : RandomSpawner replaces Shotgun
{
	DropItem "RL_Shotgun"
}
